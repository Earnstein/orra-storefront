{
  "name": "shopify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "DOTENV_CONFIG_PATH=.env.local drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "DOTENV_CONFIG_PATH=.env.local drizzle-kit push",
    "db:studio": "DOTENV_CONFIG_PATH=.env.local drizzle-kit studio",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "auth:generate": "npx auth@1.7.7 generate --config src/lib/auth.cli.ts --output src/db/schema/auth.ts",
    "skills:update": "npx skills@latest update -p -y",
    "postinstall": "node scripts/fix-intent-bin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/infra": "^0.4.14",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/intent": "^0.5.2",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ],
    "exclude": [
      "@tanstack/devtools-event-client"
    ]
  }
}

# Copy to .env and fill in values. Never commit real secrets.
# For local work, also create .env.local with DATABASE_URL pointing at a Neon development branch
# (not production): Next and the db:* scripts read .env.local before .env.

# --- Database (Neon Postgres) ---
# Pooled connection string from the Neon console (Connect > Pooled connection).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (server-side). Not needed on Vercel previews, which use their own VERCEL_URL.
BETTER_AUTH_URL="http://localhost:3000"
# Better Auth Infra dashboard (dash plugin). From the project's setup page; keep it secret.
BETTER_AUTH_API_KEY=""

# --- Production guard (Vercel builds and local db:seed / db:migrate) ---
# Hostname of the production Neon endpoint (not secret), e.g. ep-xxx.region.aws.neon.tech.
# Set in Vercel for Preview builds: they refuse to migrate/seed if DATABASE_URL points at it.
# Set it locally too, in .env: `npm run db:seed` and `npm run db:migrate` then refuse production
# unless run with `-- --production` (which in turn refuses anything else), and
# `npm run db:seed -- --check` says which database DATABASE_URL points at.
PRODUCTION_DB_HOST=""

# --- Email (Resend) ---
# API key from resend.com. Without it, emails are logged instead of sent.
RESEND_API_KEY=""
# Local runs and CI only (never on Vercel): also write each email as a JSON file in this folder,
# so end-to-end tests can read password reset links.
EMAIL_OUTBOX_DIR=""

# --- Payments (Stripe, test mode only) ---
# From the Stripe dashboard in test mode (Developers > API keys). Live keys are refused: the store
# promises "no real money". Without both keys, checkout says it's unavailable.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signs webhooks. On Vercel, from the webhook endpoint's page; locally, the one
# `stripe listen --forward-to localhost:3000/api/payments/stripe/webhook` prints.
STRIPE_WEBHOOK_SECRET=""

# --- Product photo uploads (Vercel Blob, public store) ---
# Set on Vercel by connecting the store to the project (Storage > Create Database > Blob). Uploads
# sign in with Vercel's rotating OIDC token, so there's no long-lived secret; locally they need
# `vercel env pull` (it adds VERCEL_OIDC_TOKEN). Without these the admin's photo field offers the
# catalogue's existing photos instead.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# Copy to .env.local and fill in values. Never commit real secrets.

# --- Database (Neon Postgres) ---
# Pooled connection string from the Neon console (Connect > Pooled connection).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (server-side).
BETTER_AUTH_URL="http://localhost:3000"
# Better Auth Infra dashboard (dash plugin). From the project's setup page; keep it secret.
BETTER_AUTH_API_KEY=""

# --- Production guard (Vercel builds and local seeding) ---
# Hostname of the production Neon endpoint (not secret), e.g. ep-xxx.region.aws.neon.tech.
# Set in Vercel for Preview builds: they refuse to migrate/seed if DATABASE_URL points at it.
# Set it locally too, in .env: `npm run db:seed` then refuses production unless run with
# `-- --production`, and `npm run db:seed -- --check` says which database DATABASE_URL points at.
PRODUCTION_DB_HOST=""

# --- Public ---
# Base URL exposed to the browser (used by the auth client).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
